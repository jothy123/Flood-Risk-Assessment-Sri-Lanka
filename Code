# ─────────────────────────────────────────────────────────────────────────────


def run_pipeline(cfg: dict = CFG):
    """Execute the full Sri Lanka flood risk assessment pipeline end-to-end."""
    print("=" * 65)
    print(" FLOOD RISK ASSESSMENT PIPELINE — SRI LANKA (FULL ISLAND)")
    print("=" * 65)

    # ── Stage 1: Load & clip data ─────────────────────────────────────────────
    dem_arr, transform, crs, nodata, meta = load_and_clip_dem(cfg)
    layers = load_vector_layers(cfg)

    # Save clipped DEM as GeoTIFF so pysheds can read it from disk
    clipped_dem_path = os.path.join(cfg["out_dir"], "dem_clipped.tif")
    nan_safe = np.where(np.isnan(dem_arr), -9999, dem_arr)
    with rasterio.open(clipped_dem_path, "w", **meta) as dst:
        dst.write(nan_safe.astype(np.float32), 1)
    print(f"[Stage 1] Clipped DEM saved: {clipped_dem_path}")

    # ── Stage 2: Condition DEM ────────────────────────────────────────────────
    grid, conditioned_dem = preprocess_dem(clipped_dem_path, cfg)

    # ── Stage 3: Watershed delineation ───────────────────────────────────────
    watershed = delineate_watershed(grid, conditioned_dem, cfg)

    # ── Stage 4: Flood hazard map ─────────────────────────────────────────────
    depth_arr, hazard_arr = generate_flood_hazard_map(dem_arr, meta, cfg)
    hazard_path = os.path.join(cfg["out_dir"], "flood_hazard.tif")

    # ── Stage 5: Vulnerability analysis ──────────────────────────────────────
    gn_vuln = vulnerability_analysis(hazard_path, layers, cfg)

    # ── Stage 6: Risk mapping ─────────────────────────────────────────────────
    if gn_vuln is not None:
        risk_arr = flood_risk_mapping(hazard_path, gn_vuln, meta, cfg)
    else:
        print("[Stage 6] No vulnerability layer — risk derived from hazard only.")
        risk_arr = hazard_arr.copy().astype(np.uint8)
        risk_meta = meta.copy()
        risk_meta.update(dtype="uint8", nodata=0)
        risk_path = os.path.join(cfg["out_dir"], "flood_risk.tif")
        with rasterio.open(risk_path, "w", **risk_meta) as dst:
            dst.write(risk_arr, 1)
        print(f"[Stage 6] Hazard-only risk raster saved: {risk_path}")

    # ── Stage 7: Visualize & export ───────────────────────────────────────────
    plot_dem(dem_arr, cfg)
    plot_hazard_map(hazard_arr, meta, cfg)
    plot_vulnerability_map(gn_vuln, cfg)
    plot_risk_map(risk_arr, meta, cfg)
    plot_summary_statistics(dem_arr, hazard_arr, risk_arr, gn_vuln, cfg)

    # ── Final summary ─────────────────────────────────────────────────────────
    print("\n" + "=" * 65)
    print(" PIPELINE COMPLETE — SRI LANKA FLOOD RISK ASSESSMENT")
    print("=" * 65)
    print(f" Output directory : {os.path.abspath(cfg['out_dir'])}")
    print(f" Output files:")
    for f in sorted(os.listdir(cfg["out_dir"])):
        fpath = os.path.join(cfg["out_dir"], f)
        size  = os.path.getsize(fpath) / (1024 * 1024)
        print(f"   {f:<35s}  {size:6.1f} MB")
    print("=" * 65)


