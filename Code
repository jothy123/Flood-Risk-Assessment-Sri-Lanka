    if gn_vuln is None:
        print("[Stage 7] Skipping vulnerability map — no data.")
        return

    color_map = dict(zip(VULN_LABELS, VULN_COLORS))

    fig, ax = plt.subplots(figsize=(10, 12))

    for label in VULN_LABELS:
        subset = gn_vuln[gn_vuln["vuln_class"] == label]
