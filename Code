def plot_summary_statistics(
    dem_arr: np.ndarray,
    hazard_arr: np.ndarray,
    risk_arr: np.ndarray,
    gn_vuln: gpd.GeoDataFrame,
    cfg: dict
):
    """
    Four-panel summary figure:
      Top-left  : DEM elevation histogram
      Top-right : Hazard class cell distribution
      Bot-left  : Risk class cell distribution
      Bot-right : Exposed population by vulnerability class
    """
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    fig.suptitle("Flood Risk Assessment Summary — Sri Lanka",
                 fontsize=15, fontweight="bold")

    # ── DEM histogram ─────────────────────────────────────────────────────────
    ax = axes[0, 0]
    valid_elev = dem_arr[~np.isnan(dem_arr)].ravel()
    ax.hist(valid_elev, bins=80, color="#4A90D9", edgecolor="none", alpha=0.85)
    ax.axvline(cfg["flood_level_m"], color="red", lw=1.5,
               linestyle="--", label=f"WSE = {cfg['flood_level_m']} m")
    ax.set_xlabel("Elevation (m)")
    ax.set_ylabel("Cell count")
    ax.set_title("DEM Elevation Distribution")
    ax.legend(fontsize=9)

    # ── Hazard class bar chart ────────────────────────────────────────────────
    ax = axes[0, 1]
    hazard_counts = [int(np.sum(hazard_arr == c))
                     for c in range(1, len(HAZARD_LABELS) + 1)]
    ax.bar(HAZARD_LABELS, hazard_counts,
           color=HAZARD_COLORS, edgecolor="white")
    ax.set_xlabel("Hazard Class")
    ax.set_ylabel("Cell count")
    ax.set_title("Flood Hazard — Cell Distribution")
    ax.tick_params(axis="x", rotation=15)

    # ── Risk class bar chart ──────────────────────────────────────────────────
    ax = axes[1, 0]
    risk_counts = [int(np.sum(risk_arr == c))
                   for c in range(1, len(RISK_LABELS) + 1)]
    ax.bar(RISK_LABELS, risk_counts,
           color=RISK_COLORS, edgecolor="white")
    ax.set_xlabel("Risk Class")
    ax.set_ylabel("Cell count")
    ax.set_title("Flood Risk — Cell Distribution")
    ax.tick_params(axis="x", rotation=15)

    # ── Exposed population by vulnerability class ─────────────────────────────
    ax = axes[1, 1]
    if gn_vuln is not None and "exposed_pop" in gn_vuln.columns:
        pop_by_class = (
            gn_vuln.groupby("vuln_class")["exposed_pop"]
            .sum()
            .reindex(VULN_LABELS, fill_value=0)
        )
        ax.bar(pop_by_class.index, pop_by_class.values,
               color=VULN_COLORS, edgecolor="white")
        ax.set_xlabel("Vulnerability Class")
        ax.set_ylabel("Exposed Population")
        ax.set_title("Exposed Population by Vulnerability Class")
        ax.tick_params(axis="x", rotation=15)
    else:
        ax.text(0.5, 0.5, "Population data\nnot available",
                ha="center", va="center",
                transform=ax.transAxes, fontsize=12)
        ax.set_title("Exposed Population")

    plt.tight_layout()
    out = os.path.join(cfg["out_dir"], "summary_statistics.png")
    plt.savefig(out, dpi=200, bbox_inches="tight")
    plt.close()
    print(f"[Stage 7] Saved: {out}")


