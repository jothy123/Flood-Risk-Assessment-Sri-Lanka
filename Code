# MAIN PIPELINE ORCHESTRATOR
# ─────────────────────────────────────────────────────────────────────────────

def run_pipeline(cfg: dict = CFG):
    """Execute the full flood risk assessment pipeline end-to-end."""
    print("=" * 65)
    print(" FLOOD RISK ASSESSMENT PIPELINE — KELANI RIVER BASIN")
    print("=" * 65)

    # Stage 1: Load data
    dem_arr, transform, crs, nodata, meta = load_and_clip_dem(cfg)
    layers = load_vector_layers(cfg)

    # Save clipped DEM for pysheds
    clipped_dem_path = os.path.join(cfg["out_dir"], "dem_clipped.tif")
    with rasterio.open(clipped_dem_path, "w", **meta) as dst:
        nan_safe = np.where(np.isnan(dem_arr), -9999, dem_arr)
        dst.write(nan_safe.astype(np.float32), 1)

    # Stage 2: Condition DEM
    grid, conditioned_dem = preprocess_dem(clipped_dem_path, cfg)

    # Stage 3: Watershed delineation
    watershed = delineate_watershed(grid, conditioned_dem, cfg)

    # Stage 4: Flood hazard map
    depth_arr, hazard_arr = generate_flood_hazard_map(dem_arr, meta, cfg)
    hazard_path = os.path.join(cfg["out_dir"], "flood_hazard.tif")

    # Stage 5: Vulnerability
    gn_vuln = vulnerability_analysis(hazard_path, layers, cfg)

    # Stage 6: Risk mapping
    if gn_vuln is not None:
        risk_arr = flood_risk_mapping(hazard_path, gn_vuln, meta, cfg)
    else:
        print("[Stage 6] No vulnerability layer — risk derived from hazard only.")
        risk_arr = hazard_arr.copy()

    # Stage 7: Visualize
    plot_hazard_map(hazard_arr, meta, cfg)
    plot_vulnerability_map(gn_vuln, cfg)
    plot_risk_map(risk_arr, meta, cfg)

    print("\n" + "=" * 65)
    print(" PIPELINE COMPLETE")
    print(f" Outputs saved to: {os.path.abspath(cfg['out_dir'])}")
    print("=" * 65)


