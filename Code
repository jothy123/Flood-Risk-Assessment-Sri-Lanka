# ─────────────────────────────────────────────────────────────────────────────
# STAGE 1 — DATA LOADING & ROI CLIPPING
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Load the DEM and vector layers. Clip all data to the Kelani River Basin
       bounding box so downstream processing is fast.

WHY:   Working on the full Sri Lanka DEM for a single basin analysis is wasteful.
       Clipping early reduces memory and compute time dramatically.

LIBS:  rasterio.mask  — clips raster to a polygon geometry
       geopandas       — loads/clips vector shapefiles
"""

def load_and_clip_dem(cfg: dict) -> tuple:
    """
    Load the DEM, clip to study area, and return (array, transform, crs, nodata).

    Parameters
    ----------
    cfg : dict  Pipeline configuration dictionary.

    Returns
    -------
    dem_arr   : np.ndarray  2-D elevation array (float32), clipped to bbox.
    transform : Affine      Affine transform of the clipped DEM.
    crs       : CRS         Coordinate reference system.
    nodata    : float       NoData value.
    meta      : dict        Full rasterio metadata for writing outputs.
    """
    lon_min, lat_min, lon_max, lat_max = cfg["bbox"]

    from shapely.geometry import box
    bbox_geom = box(lon_min, lat_min, lon_max, lat_max)

    with rasterio.open(cfg["dem_path"]) as src:
        dem_arr, transform = rio_mask(
            src,
            [mapping(bbox_geom)],
            crop=True,
            nodata=src.nodata or -9999,
            filled=True
        )
        meta = src.meta.copy()

    dem_arr = dem_arr[0].astype(np.float32)
    nodata  = meta.get("nodata", -9999)

    dem_arr[dem_arr == nodata] = np.nan

    meta.update({
        "driver":    "GTiff",
        "height":    dem_arr.shape[0],
        "width":     dem_arr.shape[1],
        "count":     1,
        "dtype":     "float32",
        "transform": transform,
        "nodata":    -9999,
    })

    print(f"[Stage 1] DEM loaded — shape: {dem_arr.shape}, "
          f"elevation range: {np.nanmin(dem_arr):.1f}–{np.nanmax(dem_arr):.1f} m")
    return dem_arr, transform, meta["crs"], nodata, meta


def load_vector_layers(cfg: dict) -> dict:
    """
    Load vector shapefiles (GN divisions, population, buildings, roads)
    and reproject to the target CRS.

    Returns a dict of GeoDataFrames keyed by layer name.
    """
    layers = {}
    for key in ("gn_division_path", "population_path", "buildings_path", "roads_path"):
        if os.path.exists(cfg[key]):
            gdf = gpd.read_file(cfg[key])
            if gdf.crs and str(gdf.crs) != cfg["target_crs"]:
                gdf = gdf.to_crs(cfg["target_crs"])
            name = key.replace("_path", "")
            layers[name] = gdf
            print(f"[Stage 1] Loaded {name}: {len(gdf)} features")
        else:
            print(f"[Stage 1] WARNING — {cfg[key]} not found, skipping.")
    return layers


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2 — DEM PRE-PROCESSING
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Prepare the DEM for hydrological analysis:
         a) Fill sinks/pits — remove artificial depressions that trap flow.
         b) (Optional) Smooth the DEM to reduce noise.

WHY:   Raw DEMs often contain spurious pits that interrupt flow direction
       calculations, producing incorrect watershed delineations. Filling sinks
       ensures a hydrologically conditioned surface.

LIBS:  pysheds.Grid  — wraps GRASS-style hydro algorithms (equivalent to
                        QGIS GRASS r.fill.dir / ArcGIS Fill tool).
       scipy.ndimage — Gaussian smoothing for noise reduction.

REPLACES: QGIS GRASS r.watershed, ArcGIS Spatial Analyst → Fill
"""

def preprocess_dem(dem_path: str, cfg: dict) -> Grid:
    """
    Load DEM into pysheds Grid, fill sinks, and return the conditioned Grid.

    Parameters
    ----------
    dem_path : str   Path to the clipped DEM GeoTIFF.
    cfg      : dict  Pipeline configuration.

    Returns
    -------
    grid        : pysheds.Grid  Hydrologically conditioned grid.
    inflated    : Grid raster   Pit/depression-filled DEM.
    """
    grid = Grid.from_raster(dem_path)
    dem  = grid.read_raster(dem_path)

    pit_filled = grid.fill_pits(dem)
    flooded    = grid.fill_depressions(pit_filled)
    inflated   = grid.resolve_flats(flooded)

    print("[Stage 2] DEM conditioned — pits filled, depressions resolved.")
    return grid, inflated


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3 — WATERSHED DELINEATION
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Delineate the Kelani River Basin watershed:
         a) Flow Direction  — which of the 8 neighbours does each cell drain to?
         b) Flow Accumulation — how many upstream cells drain into each cell?
         c) Stream Network  — extract river network above an accumulation threshold.
         d) Basin Boundary  — delineate the watershed from a pour point.

LIBS:  pysheds.Grid methods:
         .flowdir()      — D8 flow direction
         .accumulation() — upstream contributing area
         .catchment()    — pour-point watershed

REPLACES: QGIS GRASS r.watershed, ArcGIS Hydrology toolset
"""

DIRMAP = (64, 128, 1, 2, 4, 8, 16, 32)   # N, NE, E, SE, S, SW, W, NW

def delineate_watershed(grid: Grid, conditioned_dem, cfg: dict) -> dict:
    """
    Compute flow direction, accumulation, and catchment boundary.

    Parameters
    ----------
    grid            : pysheds.Grid  Conditioned grid from Stage 2.
    conditioned_dem : Grid raster   Pit/depression-filled DEM.
    cfg             : dict          Pipeline config.

    Returns
    -------
    results : dict  Keys: 'fdir', 'acc', 'catch', 'streams'
    """
    fdir = grid.flowdir(conditioned_dem, dirmap=DIRMAP)
    print("[Stage 3] Flow direction computed (D8).")

    acc = grid.accumulation(fdir, dirmap=DIRMAP)
    print(f"[Stage 3] Flow accumulation computed — max upstream cells: {acc.max():,.0f}")

    acc_threshold = 500
    streams = acc > acc_threshold
    print(f"[Stage 3] Stream network extracted at threshold={acc_threshold} cells.")

    # Pour point = Kelani River mouth near Colombo
    pour_lon, pour_lat = 79.882, 6.958
    catch = grid.catchment(
        x=pour_lon, y=pour_lat,
        fdir=fdir,
        dirmap=DIRMAP,
        xytype="coordinate"
    )
    print("[Stage 3] Watershed catchment delineated.")

    grid.clip_to(catch)

    return {"fdir": fdir, "acc": acc, "catch": catch, "streams": streams}


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 4 — FLOOD HAZARD MAPPING
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Generate a flood inundation map and classify it into hazard levels.

APPROACH — Bathtub / DEM-difference method:
  1. Set a flood water surface elevation (WSE) from gauge data.
  2. Inundation depth = WSE − DEM elevation (positive = flooded).
  3. Classify inundation depth into hazard levels.

HAZARD CLASSIFICATION (Sri Lanka DMC thresholds):
  Very Low  : 0   – 0.5 m
  Low       : 0.5 – 1.5 m
  Moderate  : 1.5 – 3.0 m
  High      : > 3.0 m

REPLACES: ArcGIS Model Builder flood chain (Topo→Raster, Fill, Int, Extract)
"""

HAZARD_BINS   = [0, 0.5, 1.5, 3.0, np.inf]
HAZARD_LABELS = ["Very Low", "Low", "Moderate", "High"]
HAZARD_COLORS = ["#FFFF99", "#FFC14D", "#66BB66", "#CC0000"]


def generate_flood_hazard_map(dem_arr: np.ndarray, meta: dict, cfg: dict) -> np.ndarray:
    """
    Generate inundation depth raster and classified hazard raster.

    Parameters
    ----------
    dem_arr : np.ndarray  Elevation array (NaN where nodata).
    meta    : dict        Rasterio metadata of the DEM.
    cfg     : dict        Pipeline config.

    Returns
    -------
    depth_arr  : np.ndarray  Inundation depth in meters (0 where not flooded).
    hazard_arr : np.ndarray  Integer hazard class 1–4 (0 = not flooded).
    """
    wse = cfg["flood_level_m"]

    depth_arr = np.where(
        (~np.isnan(dem_arr)) & (dem_arr < wse),
        wse - dem_arr,
        0.0
    ).astype(np.float32)

    hazard_arr = np.zeros_like(depth_arr, dtype=np.uint8)
    for i, (lo, hi) in enumerate(zip(HAZARD_BINS[:-1], HAZARD_BINS[1:]), start=1):
        hazard_arr[(depth_arr > lo) & (depth_arr <= hi)] = i
    hazard_arr[depth_arr > HAZARD_BINS[-2]] = 4

    flooded_cells = np.sum(hazard_arr > 0)
    print(f"[Stage 4] Flood hazard mapped — {flooded_cells:,} flooded cells at WSE={wse} m.")

    depth_path = os.path.join(cfg["out_dir"], "flood_depth.tif")
    with rasterio.open(depth_path, "w", **meta) as dst:
        dst.write(depth_arr, 1)

    hazard_meta = meta.copy()
    hazard_meta.update(dtype="uint8", nodata=0)
    hazard_path = os.path.join(cfg["out_dir"], "flood_hazard.tif")
    with rasterio.open(hazard_path, "w", **hazard_meta) as dst:
        dst.write(hazard_arr, 1)

    print(f"[Stage 4] Saved: {depth_path}, {hazard_path}")
    return depth_arr, hazard_arr


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 5 — VULNERABILITY ANALYSIS
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Identify how exposed the population and buildings are to flood hazard.

APPROACH — Intersect flood layer with exposure data:
  1. Intersect flood inundation area with GN Division boundaries.
  2. For each GN Division: calculate % area flooded.
  3. Join population data → compute exposed population (area-weighted).
  4. Count buildings within flood extent.
  5. Classify vulnerability:
       High     : ≥50% area flooded
       Moderate : 25–50% flooded
       Low      : 10–25% flooded
       Very Low : <10% flooded

LIBS:
  rasterstats — zonal_stats() per GN Division
  geopandas   — spatial join for building counts
  shapely     — geometry intersection for area-weighted population

REPLACES: ArcGIS Intersect tool, Cross Table operation in Model Builder
"""

VULN_BINS   = [0, 10, 25, 50, 100]
VULN_LABELS = ["Very Low", "Low", "Moderate", "High"]
VULN_COLORS = ["#006600", "#33AA33", "#FFA500", "#CC0000"]


def vulnerability_analysis(
    hazard_path: str,
    layers: dict,
    cfg: dict
) -> gpd.GeoDataFrame:
    """
    Compute flood exposure per GN Division and classify vulnerability.

    Parameters
    ----------
    hazard_path : str   Path to classified flood hazard GeoTIFF.
    layers      : dict  Vector layers loaded in Stage 1.
    cfg         : dict  Pipeline config.

    Returns
    -------
    gn_vuln : GeoDataFrame  GN Divisions with vulnerability scores and class.
    """
    import pandas as pd

    gn        = layers.get("gn_division")
    pop       = layers.get("population")
    buildings = layers.get("buildings")

    if gn is None:
        print("[Stage 5] GN Division layer not found — skipping vulnerability.")
        return None

    # ── Zonal Statistics: % flooded per GN Division ───────────────────────────
    stats = zonal_stats(
        gn,
        hazard_path,
        stats=["mean", "max", "count"],
        nodata=0,
        categorical=True,
        add_stats={"flooded_pct": _flooded_pct}
    )

    gn_vuln = gn.copy()
    gn_vuln["mean_hazard"] = [s.get("mean", 0) or 0 for s in stats]
    gn_vuln["max_hazard"]  = [s.get("max",  0) or 0 for s in stats]
    gn_vuln["flooded_pct"] = [s.get("flooded_pct", 0) or 0 for s in stats]

    # ── Area-weighted population exposure ─────────────────────────────────────
    # exposed_pop = PTOTAL × (flooded area / total area)
    # Avoids the inflated-count error from naive pixel stamping.
    if pop is not None:
        pop_col = next(
            (c for c in ["PTOTAL", "POP", "POPULATION", "pop_count"]
             if c in pop.columns), None
        )
        if pop_col:
            gn_vuln = gn_vuln.merge(pop[["GN_CODE", pop_col]], on="GN_CODE", how="left")
            gn_vuln["exposed_pop"] = (
                gn_vuln[pop_col] * gn_vuln["flooded_pct"] / 100
            ).round(0)
            print(f"[Stage 5] Total exposed population: "
                  f"{gn_vuln['exposed_pop'].sum():,.0f}")
        else:
            gn_vuln["exposed_pop"] = np.nan
            print(f"[Stage 5] Population column not found. "
                  f"Available: {list(pop.columns)}")
    else:
        gn_vuln["exposed_pop"] = np.nan

    # ── Count buildings in flood zone ─────────────────────────────────────────
    if buildings is not None:
        with rasterio.open(hazard_path) as src:
            flood_mask = src.read(1) > 0
            shapes = list(features.shapes(
                flood_mask.astype(np.uint8), transform=src.transform
            ))
        flood_polys = gpd.GeoDataFrame(
            geometry=[gpd.GeoSeries.from_wkt(
                [str(s[0]) for s in shapes if s[1] == 1]).iloc[0]],
            crs=cfg["target_crs"]
        )
        bldg_in_flood = gpd.sjoin(
            buildings, flood_polys, how="inner", predicate="intersects"
        )
        bldg_count = (bldg_in_flood.groupby("GN_CODE")
                      .size().reset_index(name="bldg_flood_count"))
        gn_vuln = gn_vuln.merge(bldg_count, on="GN_CODE", how="left")
        gn_vuln["bldg_flood_count"] = gn_vuln["bldg_flood_count"].fillna(0)
    else:
        gn_vuln["bldg_flood_count"] = 0

    # ── Classify vulnerability ────────────────────────────────────────────────
    gn_vuln["vuln_class"] = pd.cut(
        gn_vuln["flooded_pct"],
        bins=VULN_BINS,
        labels=VULN_LABELS,
        right=True
    ).astype(str)

    out_path = os.path.join(cfg["out_dir"], "vulnerability.gpkg")
    gn_vuln.to_file(out_path, driver="GPKG")
    print(f"[Stage 5] Vulnerability layer saved: {out_path}")
    print(f"[Stage 5] High vulnerability GN Divisions: "
          f"{(gn_vuln['vuln_class'] == 'High').sum()}")

    return gn_vuln


def _flooded_pct(arr):
    """Custom zonal_stats aggregation: % cells with hazard class > 0."""
    valid = arr[~np.isnan(arr)]
    if len(valid) == 0:
        return 0.0
    return float(np.sum(valid > 0) / len(valid) * 100)


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 6 — FLOOD RISK MAPPING (WEIGHTED OVERLAY)
# ─────────────────────────────────────────────────────────────────────────────
"""
WHAT:  Combine hazard and vulnerability into a single Flood Risk score.

FORMULA (mirrors assignment Model Builder weighted overlay):
  Risk = (0.60 × Hazard_Class) + (0.40 × Vulnerability_Class)

RISK CLASSES:
  1 — Very Low   (score 0   – 1.8)
  2 — Low        (score 1.8 – 2.6)
  3 — Moderate   (score 2.6 – 3.4)
  4 — High       (score 3.4 – 4.2)
  5 — Very High  (score 4.2 – 5.0)

REPLACES: ArcGIS Weighted Overlay tool (Spatial Analyst)
"""

RISK_COLORS   = ["#4DB8FF", "#66CC66", "#FFFF00", "#FFA500", "#CC0000"]
RISK_LABELS   = ["Very Low", "Low", "Moderate", "High", "Very High"]
HAZARD_WEIGHT = 0.60
VULN_WEIGHT   = 0.40


def flood_risk_mapping(
    hazard_path: str,
    gn_vuln: gpd.GeoDataFrame,
    meta: dict,
    cfg: dict
) -> np.ndarray:
    """
    Produce a classified Flood Risk raster via weighted overlay.

    Parameters
    ----------
    hazard_path : str           Path to flood hazard GeoTIFF.
    gn_vuln     : GeoDataFrame  Vulnerability layer from Stage 5.
    meta        : dict          Rasterio metadata template.
    cfg         : dict          Pipeline config.

    Returns
    -------
    risk_arr : np.ndarray  Risk class raster (1–5, 0 = outside study area).
    """
    with rasterio.open(hazard_path) as src:
        hazard_arr  = src.read(1).astype(np.float32)
        h_transform = src.transform
        h_shape     = src.shape

    vuln_map = {"Very Low": 1, "Low": 2, "Moderate": 3, "High": 4, "nan": 0}
    gn_vuln  = gn_vuln.copy()
    gn_vuln["vuln_num"] = gn_vuln["vuln_class"].map(vuln_map).fillna(0)

    vuln_shapes = [
        (geom, val)
        for geom, val in zip(gn_vuln.geometry, gn_vuln["vuln_num"])
        if geom is not None
    ]
    vuln_raster = (
        features.rasterize(vuln_shapes, out_shape=h_shape,
                           transform=h_transform, fill=0, dtype=np.float32)
        if vuln_shapes
        else np.zeros(h_shape, dtype=np.float32)
    )

    risk_score = (HAZARD_WEIGHT * hazard_arr) + (VULN_WEIGHT * vuln_raster)

    risk_arr = np.zeros(h_shape, dtype=np.uint8)
    risk_arr[(risk_score > 0)   & (risk_score <= 1.8)] = 1
    risk_arr[(risk_score > 1.8) & (risk_score <= 2.6)] = 2
    risk_arr[(risk_score > 2.6) & (risk_score <= 3.4)] = 3
    risk_arr[(risk_score > 3.4) & (risk_score <= 4.2)] = 4
    risk_arr[risk_score > 4.2]                         = 5

    risk_meta = meta.copy()
    risk_meta.update(dtype="uint8", nodata=0)
    risk_path = os.path.join(cfg["out_dir"], "flood_risk.tif")
    with rasterio.open(risk_path, "w", **risk_meta) as dst:
        dst.write(risk_arr, 1)

    print(f"[Stage 6] Flood Risk Map saved: {risk_path}")
    for i, label in enumerate(RISK_LABELS, start=1):
        print(f"          Class {i} — {label}: {np.sum(risk_arr == i):,} cells")

    return risk_arr


