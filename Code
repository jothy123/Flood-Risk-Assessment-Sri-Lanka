            subset.plot(
                ax=ax,
                color=color_map[label],
                edgecolor="white",
                linewidth=0.2,
                label=label
            )

    unclassified = gn_vuln[~gn_vuln["vuln_class"].isin(VULN_LABELS)]
    if not unclassified.empty:
        unclassified.plot(
            ax=ax, color="#CCCCCC", edgecolor="white",
            linewidth=0.2, label="No Data"
        )

    legend_handles = [
        mpatches.Patch(color=VULN_COLORS[i], label=VULN_LABELS[i])
        for i in range(len(VULN_LABELS))
    ] + [mpatches.Patch(color="#CCCCCC", label="No Data")]
    ax.legend(handles=legend_handles, loc="lower right",
              title="Vulnerability Level", fontsize=9)
    ax.set_title("Vulnerability Map — Sri Lanka",
                 fontsize=14, fontweight="bold")
    ax.set_xlabel("Longitude")
    ax.set_ylabel("Latitude")
    _add_north_arrow(ax)

    out = os.path.join(cfg["out_dir"], "map_vulnerability.png")
    plt.savefig(out, dpi=200, bbox_inches="tight")
    plt.close()
    print(f"[Stage 7] Saved: {out}")


