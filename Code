def _add_north_arrow(ax):
    """Add a north-arrow annotation to a matplotlib Axes object."""
    ax.annotate(
        "N",
        xy=(0.97, 0.15), xycoords="axes fraction",
        ha="center", va="bottom",
        fontsize=13, fontweight="bold",
        arrowprops=dict(arrowstyle="->", lw=1.5),
        xytext=(0.97, 0.08)
    )


def _add_scalebar(ax):
    """Add a simple scale bar annotation to a matplotlib Axes object."""
    x0, y0 = 0.05, 0.05
    ax.annotate(
        "", xy=(x0 + 0.1, y0),
        xytext=(x0, y0),
        xycoords="axes fraction",
        arrowprops=dict(arrowstyle="-", lw=2, color="black")
    )
    ax.text(
        x0 + 0.05, y0 + 0.015,
        "~111 km",
        ha="center", va="bottom",
        transform=ax.transAxes,
        fontsize=8
    )


def plot_dem(dem_arr: np.ndarray, cfg: dict):
    """Render a terrain overview map of the Sri Lanka DEM."""
    fig, ax = plt.subplots(figsize=(10, 12))
    im = ax.imshow(
        dem_arr,
        cmap="terrain",
        interpolation="bilinear",
        vmin=0,
        vmax=np.nanpercentile(dem_arr, 99)
    )
    plt.colorbar(im, ax=ax, fraction=0.03, pad=0.04, label="Elevation (m)")
    ax.set_title("Digital Elevation Model — Sri Lanka",
                 fontsize=14, fontweight="bold")
    ax.set_xlabel("Longitude")
    ax.set_ylabel("Latitude")
    _add_north_arrow(ax)

    out = os.path.join(cfg["out_dir"], "map_dem.png")
    plt.savefig(out, dpi=200, bbox_inches="tight")
    plt.close()
    print(f"[Stage 7] Saved: {out}")


