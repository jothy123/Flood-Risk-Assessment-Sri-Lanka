    norm = BoundaryNorm(list(range(7)), cmap.N)

    fig, ax = plt.subplots(figsize=(10, 9))
    ax.imshow(risk_arr, cmap=cmap, norm=norm, interpolation="nearest")
    ax.legend(
        handles=[mpatches.Patch(color=RISK_COLORS[i], label=RISK_LABELS[i])
                 for i in range(5)],
        loc="lower right", title="Flood Risk Level", fontsize=9
    )
    ax.set_title("Flood Risk Map — Kelani River Basin", fontsize=14, fontweight="bold")
    ax.set_xlabel("Longitude"); ax.set_ylabel("Latitude")
    _add_north_arrow(ax)

    out = os.path.join(cfg["out_dir"], "map_flood_risk.png")
    plt.savefig(out, dpi=200, bbox_inches="tight")
    plt.close()
    print(f"[Stage 7] Saved: {out}")


def _add_north_arrow(ax):
    """Add a north arrow annotation to a matplotlib axes."""
    ax.annotate(
        "N", xy=(0.97, 0.15), xycoords="axes fraction",
        ha="center", va="bottom", fontsize=13, fontweight="bold",
        arrowprops=dict(arrowstyle="->", lw=1.5),
        xytext=(0.97, 0.08)
    )


